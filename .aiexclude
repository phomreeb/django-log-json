# ==========================================
# 1. Python & Django Environments (สำคัญที่สุด)
# ==========================================
.venv/
venv/
env/
ENV/
bin/
include/
lib/
share/

# ==========================================
# 2. Python Cache & Compiled Files
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 3. Django Secrets & Local Databases
# ==========================================
.env
*.env
local_settings.py
db.sqlite3
db.sqlite3-journal

# ==========================================
# 4. Media & Static Files (ไฟล์อัปโหลดและสไตล์เชีต)
# ==========================================
# ข้ามโฟลเดอร์ที่เก็บไฟล์อัปโหลดของผู้ใช้และไฟล์ Static ที่คอมไพล์แล้ว
media/
staticfiles/
static/root/
# หมายเหตุ: ถ้าคุณเขียน CSS/JS ไว้ในโฟลเดอร์ static ของแอปพลิเคชัน 
# อาจจะเว้นไว้ให้ AI อ่านได้ แต่โฟลเดอร์รวบรวมไฟล์ (staticfiles) ควรข้ามครับ

# ==========================================
# 5. Django Migrations (แนะนำให้ข้าม)
# ==========================================
# ไฟล์ย้ายฐานข้อมูลที่ถูกสร้างอัตโนมัติ มักจะทำให้ AI สับสนตอนแนะนำโค้ด 
# การปล่อยให้ AI อ่านเฉพาะ models.py จะทำงานได้แม่นยำกว่ามากครับ
**/migrations/*.py
!**/migrations/__init__.py

# ข้ามไฟล์ที่มีนามสกุล .log ทุกไฟล์ในทุกโฟลเดอร์
*.log

# ข้ามโฟลเดอร์ที่นิยมใช้เก็บ Log ใน Django (ถ้าคุณสร้างแยกไว้)
logs/
log/